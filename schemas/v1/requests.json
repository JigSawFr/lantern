{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/requests.json",
  "title": "Requests",
  "description": "GET <base>/v1/requests (SPEC.md § 9).",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "common.json#/$defs/schema1"
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.json#/$defs/opaque"
          },
          "title_id": {
            "$ref": "common.json#/$defs/id16"
          },
          "name": {
            "$ref": "common.json#/$defs/name"
          },
          "status": {
            "enum": [
              "open",
              "done",
              "declined"
            ]
          },
          "created": {
            "$ref": "common.json#/$defs/time"
          }
        },
        "required": [
          "id",
          "title_id",
          "status",
          "created"
        ]
      }
    }
  },
  "required": [
    "schema",
    "requests"
  ]
}
