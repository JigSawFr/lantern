{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/pairing-token.json",
  "title": "Pairing token",
  "description": "GET poll once the user approved (SPEC.md § 5.2).",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "common.json#/$defs/schema1"
    },
    "token": {
      "$ref": "common.json#/$defs/opaque"
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/scope"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "token",
    "scopes"
  ]
}
