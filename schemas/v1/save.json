{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.boreale.dev/schemas/v1/save.json",
  "title": "A save backup",
  "description": "The answer to POST <base>/v1/saves/{title_id} (SPEC.md § 7).",
  "type": "object",
  "properties": {
    "schema": {
      "$ref": "common.json#/$defs/schema1"
    },
    "title_id": {
      "$ref": "common.json#/$defs/id16"
    },
    "save_id": {
      "$ref": "common.json#/$defs/opaque"
    },
    "created": {
      "$ref": "common.json#/$defs/time"
    },
    "size": {
      "$ref": "common.json#/$defs/uint64"
    },
    "sha256": {
      "$ref": "common.json#/$defs/sha256"
    },
    "note": {
      "$ref": "common.json#/$defs/note"
    },
    "device": {
      "$ref": "common.json#/$defs/name"
    }
  },
  "required": [
    "schema",
    "title_id",
    "save_id",
    "created",
    "size"
  ]
}
